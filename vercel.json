{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/library-reminders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/library-backup",
      "schedule": "0 2 * * *"
    }
  ]
}
