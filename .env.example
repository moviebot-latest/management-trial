# Local development only. Copy to .env and replace all placeholders. Never commit .env.
SECRET_KEY=replace-with-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ADMIN_EMAIL=admin@example.com
FLASK_DEBUG=0
PGSSLMODE=require
PORT=5000
BREVO_API_KEY=replace-with-real-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Management System
