# Set these in Vercel Project Settings > Environment Variables; never expose them as VITE_*.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENV=production
LATE_FEE_PER_DAY=10
DB_MAX_OPEN_CONNS=3
DB_MAX_IDLE_CONNS=1
# Email provider for registration/reset OTP:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Library Management
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
