# Local development only. Copy to .env and replace all placeholders. Never commit .env.
SECRET_KEY=replace-with-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ADMIN_EMAIL=admin@example.com
FLASK_DEBUG=0
PGSSLMODE=require
PORT=5000
BREVO_API_KEY=replace-with-real-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Library Management System

# Optional SMTP fallback (used for OTP and campaign mail when Brevo is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com

# Optional canonical production URL used for branded email buttons (no trailing slash).
PUBLIC_APP_URL=https://your-production-domain.vercel.app

# Required to protect the scheduled-campaign cron endpoint. Generate a random secret.
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: recipients processed per invocation (keep modest for serverless time limits).
EMAIL_CAMPAIGN_BATCH_SIZE=10
EMAIL_CAMPAIGN_MAX_RECIPIENTS=5000
EMAIL_CAMPAIGN_BROADCAST_COOLDOWN_SECONDS=60

# Library Management System V60
LIBRARY_UPI_ID=
LIBRARY_UPI_NAME=Library
# Fine rate and grace period can also be changed from Admin > Library Settings.
# Initial default: INR 10/day, 0 grace days.

# Off-site automatic backups (S3-compatible storage)
BACKUP_S3_BUCKET=your-private-backup-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-limited-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-limited-backup-secret

# Optional custom S3-compatible endpoint (e.g. private S3-compatible storage)
BACKUP_S3_ENDPOINT=
