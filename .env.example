# Local development only. Copy to .env and replace all placeholders. Never commit .env.
SECRET_KEY=replace-with-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ADMIN_EMAIL=admin@example.com
FLASK_DEBUG=0
PGSSLMODE=require
PORT=5000
BREVO_API_KEY=replace-with-real-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Management System

# Optional SMTP fallback (used for OTP when Brevo is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com
